{
    "name": "contao/managed-edition",
    "description": "Contao Managed Edition",
    "license": "LGPL-3.0-or-later",
    "type": "project",
    "require": {
        "cgo-it/contao-xls_export-bundle": "^4.0",
        "christianbarkowsky/coverpicture": "^1.3",
        "christianbarkowsky/tabcontrol": "^3.0",
        "codefog/contao-widget_tree_picker": "^2.4",
        "contao-community-alliance/composer-plugin": "^3.2",
        "contao-dms/dms": "^3.2",
        "contao/calendar-bundle": "^4.9",
        "contao/comments-bundle": "^4.9",
        "contao/conflicts": "*@dev",
        "contao/faq-bundle": "^4.9",
        "contao/listing-bundle": "^4.9",
        "contao/manager-bundle": "4.9.*",
        "contao/news-bundle": "^4.9",
        "contao/newsletter-bundle": "^4.9",
        "discordier/justtextwidgets": "^1.2",
        "do-while/contao-backupdb-bundle": "^1.5",
        "dompdf/dompdf": "^1.2",
        "esit/downloadmail": "^2.1",
        "kigkonsult/icalcreator": "^2.39",
        "kmielke/calendar-extended-bundle": "^1.0",
        "madeyourday/contao-rocksolid-antispam": "^2.0",
        "madeyourday/contao-rocksolid-slider": "^2.1",
        "metamodels/bundle_all": "^2.1",
        "pbd-kn/contao-efg-bundle": "^1.0",
        "terminal42/contao-avatar": "^1.3",
        "terminal42/contao-changelanguage": "^3.3"
    },
    "conflict": {
        "contao-components/installer": "<1.3"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "contao-community-alliance/composer-plugin": true,
            "contao-components/installer": true,
            "contao/manager-plugin": true
        }
    },
    "extra": {
        "contao-component-dir": "assets"
    },
    "scripts": {
        "post-install-cmd": [
            "Contao\\ManagerBundle\\Composer\\ScriptHandler::initializeApplication"
        ],
        "post-update-cmd": [
            "Contao\\ManagerBundle\\Composer\\ScriptHandler::initializeApplication"
        ]
    }
}
