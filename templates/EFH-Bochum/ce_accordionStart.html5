  <div class="<?php echo $this->toggler; ?>"<?php if ($this->headlineStyle): ?> style="<?php echo $this->headlineStyle; ?>"<?php endif; ?>>
    <?php echo $this->headline; ?>
    <div class="icon svg"></div>
  </div>

  <div class="<?php echo $this->accordion; ?>"><div>
