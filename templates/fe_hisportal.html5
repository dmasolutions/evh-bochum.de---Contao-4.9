		<?php echo $this->mootools; ?>

		<?php if (!$this->disableCron): ?>
			<script>
			<?php if ($this->layout->addJQuery): ?>
				setTimeout(function(){jQuery.ajax("system/cron/cron.txt",{complete:function(e){var t=e.responseText||0;parseInt(t)<Math.round(+(new Date)/1e3)-<?php echo $this->cronTimeout?:0 ?>&&jQuery.ajax("system/cron/cron.php")}})},5e3)
			<?php else: ?>
				setTimeout(function(){(new Request({url:"system/cron/cron.txt",onComplete:function(e){e||(e=0),parseInt(e)<Math.round(+(new Date)/1e3)-<?php echo $this->cronTimeout?:0 ?>&&(new Request({url:"system/cron/cron.php"})).get()}})).get()},5e3)
			<?php endif; ?>
			</script>
		<?php endif; ?>

