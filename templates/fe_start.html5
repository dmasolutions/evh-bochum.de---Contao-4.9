        <style>
#topbar-off .loginbox .submit{position:absolute;bottom:-2em;right:0;height:2em;border:none;background-color:transparent}#topbar-off .loginbox .submit:hover{background-color:#378bd2}
button.submit{background:#004e91;color:#fff;font-weight:700}button.submit:focus,button.submit:hover{background-color:#0069c4;outline:0}
button {
    background: #fff;
    border: 1px solid #004e91;
    padding: 0.5em;
    height: 3em;
    margin: 0;
    border-radius: 0;
    -webkit-border-radius: 0;
}
#topbar-off .loginbox button {
    position: relative;
    height: 3em;
    min-width: 5em;
    width: auto;
    max-width: 14em;
    color: #fff;
    border: none;
    border-bottom: 1px solid #fff;
    outline: 0;
    background-color: #378bd2;
    font-weight: 400;
    font-style: normal;
    font-family: 'Open Sans Bold';
    display: block;
    float: right;
    padding: 0 1em;
    margin-left: 0.5em;
}
.mod_search .widget.widget-text {
        width: 80%;
    display: inline-block;
}
.mod_search input[type=search] {
        width: 100%;
}
.mod_search .widget.widget-submit {
        width: 14%;
    display: inline-block;
}
</style>
